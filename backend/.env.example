HOST=127.0.0.1
PORT=8000
DEBUG=False
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
USE_LOCAL_RAG2=True
ENABLE_MOCK_RAG2=False

# Groq LLM & Voice (Free, fast API from https://console.groq.com)
# Get a free key from https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Optional alternative voice provider (Deepgram gives $200 free credit)
DEEPGRAM_API_KEY=

# BHASHINI multilingual translation (obtain credentials from the BHASHINI/ULCA profile)
BHASHINI_ENABLED=False
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=
BHASHINI_CONFIG_URL=https://meity-auth.ulcacontrib.org/ulca/apis/v0/model/getModelsPipeline
BHASHINI_INFERENCE_URL=
BHASHINI_TIMEOUT_SECONDS=20

# Human IP facilitator review queue
HUMAN_ESCALATION_ENABLED=True
IP_FACILITATOR_EMAIL=
